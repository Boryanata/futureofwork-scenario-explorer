    {
      "id": "rule_exposure_baseline_not_prediction",
      "name": "AI exposure is a baseline not a forecast",
      "conditions": {
        "operator": "any",
        "clauses": [
          {
            "all": [
              {
                "field": "ai_exposure",
                "operator": "equals",
                "value": "low"
              }
            ]
          },
          {
            "all": [
              {
                "field": "ai_exposure",
                "operator": "equals",
                "value": "medium"
              }
            ]
          },
          {
            "all": [
              {
                "field": "ai_exposure",
                "operator": "equals",
                "value": "high"
              }
            ]
          }
        ]
      },
      "geography": "general",
      "outcome": {
        "primary": "employment",
        "secondary": [],
        "tendency": "contextual",
        "confidence": "stronger"
      },
      "work_design_pattern": "baseline_only",
      "narrative_template": "AI exposure indicates where AI capabilities are close to occupational requirements, but it does not determine job loss, adoption speed, or realized labor outcomes.",
